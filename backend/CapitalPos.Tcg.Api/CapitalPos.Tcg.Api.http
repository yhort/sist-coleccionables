@CapitalPos.Tcg.Api_HostAddress = http://localhost:5249
@empresaId = c0a1e001-0000-4000-8000-000000000001
@sedeId = c0a1e001-0000-4000-8000-000000000010

### Health
GET {{CapitalPos.Tcg.Api_HostAddress}}/health
Accept: application/json

### a) Login JWT
# @name login
//POST {{CapitalPos.Tcg.Api_HostAddress}}/api/auth/login
POST {{CapitalPos.Tcg.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@trunqi.local",
  "password": "Admin123!",
  "empresaId": "{{empresaId}}"
}

### b) Listar productos TCG (Bearer + tenant)
GET {{CapitalPos.Tcg.Api_HostAddress}}/api/productos-tcg
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}

### Setup — crear carta para el ajuste de kardex
# @name crearCarta
POST {{CapitalPos.Tcg.Api_HostAddress}}/api/productos-tcg
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}
Content-Type: application/json

{
  "tipoProducto": "CARTA",
  "nombre": "Pikachu Paldea Evolved 070 NM",
  "codigoSku": "PKM-SV2-070-NM",
  "precioVenta": 12.5,
  "costo": 4,
  "carta": {
    "juego": "Pokémon",
    "setCodigo": "SV2",
    "setNombre": "Paldea Evolved",
    "numeroCarta": "070/193",
    "rareza": "COMUN",
    "idioma": "ES",
    "condicion": "NM",
    "esFoil": false
  }
}

### c) Ajuste de inventario → asiento kardex AJUSTE (inmutable)
# @name ajustar
PUT {{CapitalPos.Tcg.Api_HostAddress}}/api/inventario/ajustar
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}
Content-Type: application/json

{
  "productoId": "{{crearCarta.response.body.id}}",
  "sedeId": "{{sedeId}}",
  "cantidad": 4,
  "sentido": "ENTRADA",
  "motivo": "Ingreso inicial de vitrina para pruebas HTTP"
}

### Verificar kardex del ajuste
GET {{CapitalPos.Tcg.Api_HostAddress}}/api/inventario/kardex?productoId={{crearCarta.response.body.id}}&sedeId={{sedeId}}&tipoMovimiento=AJUSTE
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}

### Setup — sellado para apertura
# @name crearSellado
POST {{CapitalPos.Tcg.Api_HostAddress}}/api/productos-tcg
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}
Content-Type: application/json

{
  "tipoProducto": "SELLADO",
  "nombre": "ETB Prismatic Evolutions",
  "codigoSku": "PKM-PRE-ETB-HTTP",
  "precioVenta": 249.9,
  "costo": 180,
  "sellado": {
    "juego": "Pokémon",
    "edicion": "Prismatic Evolutions",
    "tipoSellado": "COLECCION",
    "cartasEsperadas": 45,
    "permiteApertura": true
  }
}

### Stock del sellado (entrada para poder abrir)
PUT {{CapitalPos.Tcg.Api_HostAddress}}/api/inventario/ajustar
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}
Content-Type: application/json

{
  "productoId": "{{crearSellado.response.body.id}}",
  "sedeId": "{{sedeId}}",
  "cantidad": 2,
  "sentido": "ENTRADA",
  "motivo": "Compra ETB para wizard de apertura"
}

### Apertura — crear borrador
# @name crearApertura
POST {{CapitalPos.Tcg.Api_HostAddress}}/api/aperturas-tcg
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}
Content-Type: application/json

{
  "sedeId": "{{sedeId}}",
  "productoSelladoId": "{{crearSellado.response.body.id}}",
  "cantidadSellados": 1,
  "observacion": "Pull session de prueba"
}

### Apertura — detalles (prorrateo de costo / yield)
PUT {{CapitalPos.Tcg.Api_HostAddress}}/api/aperturas-tcg/{{crearApertura.response.body.id}}/detalles
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}
Content-Type: application/json

[
  {
    "productoCartaId": "{{crearCarta.response.body.id}}",
    "cantidad": 2,
    "estado": "NM",
    "esFoil": false
  }
]

### Apertura — confirmar (kardex APERTURA_SALIDA_SELLADO + APERTURA_INGRESO_CARTA)
POST {{CapitalPos.Tcg.Api_HostAddress}}/api/aperturas-tcg/{{crearApertura.response.body.id}}/confirmar
Authorization: Bearer {{login.response.body.accessToken}}
X-CapitalPos-EmpresaId: {{empresaId}}

